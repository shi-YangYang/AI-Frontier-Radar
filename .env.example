# Optional seed: Feishu custom bot webhook.
# You can also configure Feishu webhooks later in http://127.0.0.1:3000/settings.
# Keep real webhook URLs secret; never commit them.
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace-with-real-token

# Initial admin account. Used only when the users table is empty on first start.
# If ADMIN_PASSWORD is omitted, a random password is generated and printed to the logs.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-please

# Optional runtime overrides. The app has local defaults for these.
# NODE_ENV=development
# HOST=127.0.0.1
# PORT=3000
# LOG_LEVEL=info

# Optional storage/queue overrides.
# SQLITE_PATH=.data/ai-news-monitor.sqlite
# REDIS_URL=redis://127.0.0.1:1

# Optional browser source overrides. Browser mode is the default.
# X_SOURCE_MODE=browser
# X_BROWSER_USER_DATA_DIR=.x-browser-public-profile
# 无头/有头也可在 Web 控制台 /settings -> X 数据源 中配置，运行时设置优先。
# X_BROWSER_BASE_URL=https://x.com
# X_BROWSER_PROXY_URL=
# X_BROWSER_NAVIGATION_TIMEOUT_MS=30000
# X_BROWSER_POST_LOAD_TIMEOUT_MS=15000

# Optional RSS fetch proxy (http/https only). Can also be set in /settings -> RSS 源.
# RSS_PROXY_URL=http://127.0.0.1:7890

# Optional paid X API mode. Required only when X_SOURCE_MODE=api.
# X_API_BASE_URL=https://api.x.com
# X_API_BEARER_TOKEN=replace-with-real-token

# Optional polling behavior.
# POLL_INTERVAL_SECONDS=300
# FETCH_LIMIT_PER_ACCOUNT=5
# EXCLUDE_REPLIES=true
# EXCLUDE_REPOSTS=true

# Watch accounts are managed in SQLite through http://127.0.0.1:3000/accounts.
# Use env/file only as a startup seed import path; it will not disable database-only accounts.
# WATCH_ACCOUNTS_SOURCE=database
# WATCH_ACCOUNTS=openai,AnthropicAI
