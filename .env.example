NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# SQLite database file. Prisma commands resolve this relative to the project root.
SQLITE_PATH=.data/ai-news-monitor.sqlite

# Redis is used by readiness checks and is the planned queue dependency for V1 runtime.
REDIS_URL=redis://127.0.0.1:6379

# Feishu custom bot webhook. Keep this secret; APIs and logs must not echo it.
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace-with-real-token

# X source mode. Browser mode is the free-first default.
X_SOURCE_MODE=browser

# Browser source settings. First run should stay non-headless so you can log in to X.
X_BROWSER_USER_DATA_DIR=.x-browser-profile
X_BROWSER_HEADLESS=false
X_BROWSER_BASE_URL=https://x.com
X_BROWSER_NAVIGATION_TIMEOUT_MS=30000
X_BROWSER_POST_LOAD_TIMEOUT_MS=15000

# Optional paid X API mode. Required only when X_SOURCE_MODE=api.
# X_API_BASE_URL=https://api.x.com
# X_API_BEARER_TOKEN=replace-with-real-token

# Polling behavior.
POLL_INTERVAL_SECONDS=120
FETCH_LIMIT_PER_ACCOUNT=10
EXCLUDE_REPLIES=true
EXCLUDE_REPOSTS=true

# Seed watch accounts at startup. Comma-separated usernames, with or without @.
# Existing database rows are updated for enabled state only.
WATCH_ACCOUNTS_SOURCE=env
WATCH_ACCOUNTS=openai,AnthropicAI
